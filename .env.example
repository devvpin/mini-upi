# Copy to .env (git-ignored). Generate every secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"

DB_PASSWORD=change-me
DATABASE_URL=postgresql+asyncpg://miniupi:change-me@db:5432/miniupi

# Crypto secrets (app refuses to start if any is missing)
PEPPER=
JWT_SECRET=
AUDIT_HMAC_KEY=
SWITCH_BANK_MAC_KEY=

# Key/cert files (mounted from ./secrets, never committed)
CA_CERT_PATH=/run/secrets/ca_cert.pem
PSP_KEY_PATH=/run/secrets/psp_key.pem
PSP_CERT_PATH=/run/secrets/psp_cert.pem
BANK_KEY_PATH=/run/secrets/bank_key.pem
BANK_CERT_PATH=/run/secrets/bank_cert.pem
SERVER_ECDH_KEY_PATH=/run/secrets/server_ecdh_key.pem

# App
APP_ENV=development
WEB_ORIGIN=https://localhost
VPA_SUFFIX=gcet
TOKEN_TTL_MINUTES=15
TS_WINDOW_SECONDS=60
MAX_TXN_PAISE=500000
DAILY_LIMIT_PAISE=2000000
INITIAL_BALANCE_STUDENT_PAISE=100000
INITIAL_BALANCE_FACULTY_PAISE=200000
DEMO_MODE=false
